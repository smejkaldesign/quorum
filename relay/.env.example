# Quorum relay. Copy to relay/.env for a local run (gitignored) or set these on the Railway service.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# speech engines: at least the one RELAY_ENGINE names
ASSEMBLYAI_API_KEY=
DEEPGRAM_API_KEY=
RELAY_ENGINE=assemblyai
# running summary and final notes on Quorum's key; leave empty to serve speech only
ANTHROPIC_API_KEY=
# model used when an organization points summary or notes at an OpenAI or OpenAI-compatible connector
RELAY_OPENAI_MODEL=gpt-4o-mini
PORT=8787
