# Quorum relay. Copy to relay/.env for a local run (gitignored) or set these on the Railway service.
# docs/self-hosting.md, "Running the transcription relay", explains each one.

# Supabase project: the anon key checks the app's session token, the service role reads membership and writes usage
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# speech engines: at least the one RELAY_ENGINE names (assemblyai or deepgram)
ASSEMBLYAI_API_KEY=
DEEPGRAM_API_KEY=
RELAY_ENGINE=assemblyai

# running summary and final notes on the relay's own key; leave empty to serve speech only
ANTHROPIC_API_KEY=
# model used when an organization points summary or notes at an OpenAI or OpenAI-compatible connector
RELAY_OPENAI_MODEL=gpt-4o-mini

# caps: audio per connection (seconds) and how long a connection may go without a frame (milliseconds)
RELAY_MAX_SESSION_SECONDS=14400
RELAY_IDLE_MS=20000

# Zoom app (docs/specs/meeting-sources.md): the relay exchanges authorization codes and refreshes tokens with the client
# secret, and checks recording.completed webhooks with the Secret Token. Leave empty to serve no Zoom connections.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET=

# Stripe billing (relay/billing.js): Checkout, the billing portal, and the webhook at /v1/billing/webhook.
# Leave empty to run without paid plans.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SEAT_PRICE=price_...
STRIPE_PACK_PRICE=price_...
# where Checkout and the portal return to
BILLING_RETURN_URL=https://quorum.watch

PORT=8787
