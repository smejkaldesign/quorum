{
  "name": "quorum",
  "license": "Apache-2.0",
  "version": "0.2.0",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "build": "vite build",
    "build:cloud": "QUORUM_EDITION=cloud vite build",
    "start": "vite build && node dev-app.cjs",
    "start:cloud": "QUORUM_EDITION=cloud vite build && QUORUM_EDITION=cloud node dev-app.cjs",
    "dev": "osascript -e 'if application id \"design.smejkal.quorum\" is running then quit app id \"design.smejkal.quorum\"' && sleep 1 && npm start",
    "typecheck": "tsc --noEmit",
    "check:edition": "node scripts/check-edition-boundary.mjs",
    "db:local": "cd .. && supabase start; supabase status -o env | grep -E '^(API_URL|STUDIO_URL|INBUCKET_URL|MAILPIT_URL)'",
    "package": "vite build && cd ../helper && swift build -c release && cd ../app && electron-builder --mac",
    "package:cloud": "QUORUM_EDITION=cloud vite build && cd ../helper && swift build -c release && cd ../app && node scripts/package-cloud.mjs",
    "lint": "npm ci --prefix lint --no-audit --no-fund --silent && eslint .",
    "test": "vitest run",
    "test:helper": "swift test --package-path ../helper",
    "check:content": "node scripts/check-founder-content.mjs",
    "eval": "node eval/run.mjs",
    "eval:synthetic": "node eval/make-synthetic.mjs",
    "eval:ci": "node eval/make-synthetic.mjs && node eval/run.mjs --engines apple --fail-over 0.25"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/markdown": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "26.17.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "electron-updater": "^6.8.11"
  },
  "productName": "Quorum",
  "description": "Meetings and your second brain, on your Mac",
  "build": {
    "appId": "design.smejkal.quorum",
    "productName": "Quorum",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "edition.js",
      "ee/**",
      "connectors/**",
      "onboarding.js",
      "decisions.js",
      "control.js",
      "agent.js",
      "suggest.js",
      "json.js",
      "vault.js",
      "vindex.js",
      "clusters.js",
      "linkparse.js",
      "relink.js",
      "preload.cjs",
      "store/**",
      "guards/**",
      "dist/**",
      "assets/**",
      "package.json",
      "build/**"
    ],
    "extraResources": [
      {
        "from": "../helper/.build/release/QuorumHelper",
        "to": "QuorumHelper"
      },
      {
        "from": "cli/quorum.mjs",
        "to": "cli/quorum.mjs"
      }
    ],
    "mac": {
      "target": [
        "dir",
        "dmg"
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Quorum transcribes your side of a meeting on this Mac.",
        "NSAudioCaptureUsageDescription": "Quorum transcribes the other people in a meeting on this Mac.",
        "NSSpeechRecognitionUsageDescription": "Quorum turns meeting audio into text on this Mac.",
        "NSCalendarsFullAccessUsageDescription": "Quorum shows your upcoming meetings on Home."
      }
    },
    "dmg": {
      "title": "Quorum",
      "contents": [
        {
          "x": 150,
          "y": 190
        },
        {
          "x": 390,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "background": "assets/dmg-background.png",
      "window": {
        "width": 540,
        "height": 380
      },
      "iconSize": 96
    },
    "afterPack": "./after-pack.cjs",
    "publish": {
      "provider": "github",
      "owner": "smejkaldesign",
      "repo": "quorum"
    },
    "asarUnpack": []
  },
  "author": "Smejkal Design"
}
